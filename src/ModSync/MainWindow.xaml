                                               FontFamily="Consolas, monospace"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="Apply these reviewed changes to the selected categories. Replaced and removed files are backed up; excluded mods are kept."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="90"
                                        Margin="0,0,10,0"
                                        Click="CloseModal_Click" />
                                <Button Content="Play anyway" Click="PlayAnyway_Click" Visibility="{Binding Visibility, ElementName=LaunchBanner}"
                                        Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" Height="42"/>
                                <Button Content="Apply Updates"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="42"
                                        Width="130"
                                        Click="ConfirmSync_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ================= 8. APPLICATION UPDATE MODAL ================= -->
                        <StackPanel x:Name="UpdateSheet" Visibility="Collapsed">
                            <TextBlock Text="New ModSync Update Available"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="UpdateSheetVersionText"
                                       Text="ModSync v1.1.0 is available"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,12" />

                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="UpdateSheetReleaseTitle"
                                                   Text="ModSync Release"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="UpdateSheetSizeText"
                                                   Grid.Column="1"
                                                   Text="~68 MB"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>

                                    <TextBlock Text="Release Notes:"
                                               FontSize="11"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="0,0,0,4" />

                                    <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="UpdateSheetNotesText"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="ModSync will download the update, replace the executable, and restart."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" />

                            <Grid>
                                <Button Content="View on Web"
                                        Style="{StaticResource GhostButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Click="OpenReleaseWeb_Click" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Later"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Width="80"
                                            Margin="0,0,10,0"
                                            Click="CloseModal_Click" />
                                    <Button x:Name="ApplyUpdateButton"
                                            Content="Update &amp; Restart"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="42"
                                            Width="160"
                                            Click="ApplyUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- ================= 9. IGNORED MODS & EXCLUSIONS MODAL ================= -->
                        <StackPanel x:Name="IgnoredModsSheet" Visibility="Collapsed">
                            <TextBlock Text="Ignored Mods &amp; Exclusions"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="Personal mods won't be deleted on sync. Unwanted repo mods won't be downloaded."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       LineHeight="17"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" />

                            <!-- Add Rule Input Card -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="14,12"
                                    Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ADD NEW EXCLUSION"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               Margin="1,0,0,8" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NewIgnorePatternInput"
                                                 Style="{StaticResource MinimalTextBoxStyle}"
                                                 Height="34"
                                                 Padding="10,0"
                                                 ToolTip="Enter mod filename or pattern (e.g. *zoom*, optifine*.jar, mymod.jar)"
                                                 KeyDown="NewIgnorePatternInput_KeyDown"
                                                 Margin="0,0,8,0" />
                                        <Button Content="+ Add Rule"
                                                Style="{StaticResource CompactPrimaryButtonStyle}"
                                                Grid.Column="1"
                                                Height="34"
                                                Padding="14,0"
                                                Click="AddIgnorePattern_Click" />
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,0,0,10" />

                                    <TextBlock Text="SEARCH DETECTED MODS" FontSize="11" Margin="0,0,0,8"/>
                                    <TextBox x:Name="ExclusionSearchInput" Style="{StaticResource MinimalTextBoxStyle}"
                                             Height="34" Margin="0,0,0,8" TextChanged="ExclusionSearch_Changed"
                                             AutomationProperties.Name="Search detected mods" ToolTip="Search detected mod filenames"/>
                                    <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel x:Name="DetectedModsList"/>
                                    </ScrollViewer>
                                    <CheckBox x:Name="RememberModIdentity" Content="Keep excluded across updates (Fabric mods)"
                                              Margin="0,8,0,4" MinHeight="32"/>
                                    <TextBlock Text="Uses the embedded mod ID. Other files use filename exclusions."
                                               FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Select Shown" Click="SelectShownMods_Click" Style="{StaticResource CompactSecondaryButtonStyle}" Height="32" Margin="0,0,8,4"/>
                                        <Button Content="Clear Selection" Click="ClearSelectedMods_Click" Style="{StaticResource CompactSecondaryButtonStyle}" Height="32" Margin="0,0,8,4"/>
                                        <Button x:Name="ExcludeSelectedModsButton" Content="Exclude Selected" IsEnabled="False" Click="ExcludeSelectedMods_Click"
                                                Style="{StaticResource CompactPrimaryButtonStyle}" Height="32" Margin="0,0,0,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ExclusionDropZone" AllowDrop="True"
                                    PreviewDragOver="ExclusionDropZone_DragOver"
                                    PreviewDragLeave="ExclusionDropZone_DragLeave"
                                    PreviewDrop="ExclusionDropZone_Drop"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock x:Name="ExclusionDropHint" Text="Drop .jar files here to exclude them"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="Select several files in File Explorer. Files stay where they are."
                                               Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11"
                                               TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Button Content="Choose Files…" HorizontalAlignment="Left" Height="32"
                                            Style="{StaticResource CompactSecondaryButtonStyle}"
                                            Click="ChooseExcludedFiles_Click" />
                                    <TextBlock x:Name="ExclusionDropFeedback" Visibility="Collapsed"
                                               AutomationProperties.LiveSetting="Polite"
                                               Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Active Ignored Rules List -->
                            <TextBlock Text="ACTIVE EXCLUSION RULES"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="1,0,0,6" />
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    Margin="0,0,0,16">
                                <ScrollViewer MaxHeight="135" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="IgnoredRulesContainer">
                                        <TextBlock x:Name="NoIgnoredRulesText"
                                                   Text="No mods excluded. All mods in repository will sync."
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,14" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>

                            <!-- Footer Actions -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Tip: Wildcards like *zoom* or replaymod*.jar are supported."
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0" />

                                <Button Grid.Column="1"
                                        Content="Done"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="36"
                                        Width="84"
                                        Click="CloseIgnoredMods_Click" />
                            </Grid>
                        </StackPanel>

                        <!-- ================= 10. FABRIC LOADER CONFIRMATION MODAL ================= -->
                        <StackPanel x:Name="FabricUpdateConfirmSheet" Visibility="Collapsed">
                            <TextBlock Text="Update Fabric Loader?"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <TextBlock x:Name="FabricConfirmSummaryText"
                                       Text="A new version of Fabric Loader is required."
                                       FontSize="12.5"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,14" />

                            <!-- Version Comparison Card (Apple Design) -->
                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14"
                                    Margin="0,0,0,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Version:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="FabricModalCurrentVerText" Grid.Row="0" Grid.Column="1" Text="0.15.11" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Required Version:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="FabricModalTargetVerText" Grid.Row="1" Grid.Column="1" Text="0.16.9" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Minecraft Version:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,8" />
                                    <TextBlock x:Name="FabricModalMcVerText" Grid.Row="2" Grid.Column="1" Text="1.20.1" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,8" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Target Instance:" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="FabricModalInstancePathText" Grid.Row="3" Grid.Column="1" Text=".minecraft" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </Border>

                            <TextBlock Text="This will download and install the required Fabric Loader profile in your local .minecraft folder. Your existing mods and worlds will not be affected."
                                       FontSize="11.5"
                                       LineHeight="16"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,18" />

                            <!-- Modal Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="Cancel"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="38"
                                            Width="85"
                                            Margin="0,0,10,0"
                                            Click="CloseModal_Click" />
                                    <Button x:Name="ConfirmFabricUpdateButton"
                                            Content="Update Loader"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="38"
                                            Padding="16,0"
                                            Click="ConfirmFabricUpdate_Click" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
                </ScrollViewer>
            </Grid>
        <ResizeGrip HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Margin="0,0,4,4" Foreground="{DynamicResource SecondaryTextBrush}"/>
        </Grid>
    </Border>
</Window>
