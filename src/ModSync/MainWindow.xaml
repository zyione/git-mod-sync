<Window x:Class="ModSync.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModSync" Width="620" Height="860" MinWidth="580" MinHeight="640"
        Icon="{DynamicResource AppIcon}"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" FontFamily="{StaticResource SystemFont}" PreviewKeyDown="Window_KeyDown">
    <Border Background="{DynamicResource AppBackgroundBrush}" BorderBrush="{DynamicResource WindowBorderBrush}" BorderThickness="1" CornerRadius="16" SnapsToDevicePixels="True">
        <Grid>
            <Grid x:Name="MainDashboard" Margin="24,12,24,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Click="ThemeToggle_Click" Style="{StaticResource GhostButtonStyle}" ToolTip="Switch light or dark theme" AutomationProperties.Name="Switch theme"><TextBlock x:Name="ThemeIconText" Text="Theme"/></Button>
                    <Button Content="—" Click="Minimize_Click" Style="{StaticResource GhostButtonStyle}" ToolTip="Minimize" AutomationProperties.Name="Minimize"/>
                    <Button Content="×" Click="Close_Click" Style="{StaticResource GhostButtonStyle}" ToolTip="Close" AutomationProperties.Name="Close"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{DynamicResource HeaderIcon}" Width="24" Height="24" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="ModSync" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                  </StackPanel>
                </DockPanel>
                <ScrollViewer x:Name="ActionsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                 <StackPanel>
                  <Border x:Name="LaunchBanner" Visibility="Collapsed" Style="{StaticResource ContentCardStyle}">
                    <StackPanel>
                      <TextBlock Text="Minecraft is waiting" FontSize="15" FontWeight="SemiBold"/>
                      <TextBlock Text="Review updates, or choose to play with your current files." TextWrapping="Wrap" Style="{StaticResource MetadataTextStyle}" Margin="0,4,0,8"/>
                      <WrapPanel IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}">
                        <Button Content="Check again" Click="LaunchCheck_Click" Style="{StaticResource CompactPrimaryButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Play anyway" Click="PlayAnyway_Click" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,8,8"/>
                        <Button Content="Cancel launch" Click="CancelLaunch_Click" Style="{StaticResource CompactSecondaryButtonStyle}" Margin="0,0,0,8"/>
                      </WrapPanel>
                    </StackPanel>
                  </Border>
                  <Border x:Name="UpdateBanner" Visibility="Collapsed" Style="{StaticResource ContentCardStyle}">
                    <DockPanel><Button DockPanel.Dock="Right" Content="Update" Style="{StaticResource CompactPrimaryButtonStyle}" Click="OpenUpdateModal_Click"/>
                    <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource GhostButtonStyle}" Click="DismissUpdateBanner_Click" ToolTip="Dismiss update banner" AutomationProperties.Name="Dismiss update banner"/>
                    <TextBlock x:Name="UpdateBannerText" Text="ModSync update available" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
                  </Border>
                  <DockPanel>
                    <Button x:Name="MainInstanceButton" DockPanel.Dock="Right" Content="Change instance" Style="{StaticResource GhostButtonStyle}" Click="ChooseInstance_Click" IsEnabled="{Binding IsEnabled, ElementName=ChooseInstanceButton}" Margin="12,0,0,0"/>
                    <TextBlock x:Name="InstanceNameText" Text="Choose an instance" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                  </DockPanel>
                  <TextBlock x:Name="InstanceVersionText" Text="Your Minecraft modpack" Style="{StaticResource MetadataTextStyle}" Margin="0,4,0,0"/>
                  <TextBlock x:Name="ModsFolderPathText" Style="{StaticResource MetadataTextStyle}" TextTrimming="CharacterEllipsis" Margin="0,4,0,16"/>
                  <Border Style="{StaticResource ContentCardStyle}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Margin="0,0,12,0">
                        <TextBlock x:Name="LaunchSetupHeading" Text="Launch check · Off" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="LaunchSetupDescription" Text="Check before Minecraft starts." Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                      </StackPanel>
                      <Button x:Name="LaunchSetupButton" Grid.Column="1" Content="Enable" Style="{StaticResource CompactSecondaryButtonStyle}" VerticalAlignment="Center" Click="LaunchSetup_Click" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}"/>
                    </Grid>
                  </Border>
                  <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SecondaryTextBrush}" Margin="0,0,8,0"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="OverallStatusText" Text="Ready to check" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock x:Name="LastCheckedText" Text="Check for differences with your repositories" Style="{StaticResource MetadataTextStyle}" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
                    <Button x:Name="DashboardCheckButton" Grid.Column="2" Content="Check Now" Style="{StaticResource CompactSecondaryButtonStyle}" Click="CheckStatus_Click"/>
                  </Grid>
                  <TextBlock Text="MODPACK CONTENT" Style="{StaticResource MetadataTextStyle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
<Border Style="{StaticResource ContentCardStyle}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Mods" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="StatusHeadingText" Text="Not checked" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ModCountBadgeText" Text="Counts available after checking" Style="{StaticResource MetadataTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="StatusSubText" Style="{StaticResource MetadataTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
        <Border x:Name="ModCountBadgeBorder"><TextBlock x:Name="ModCountStatusIcon" Visibility="Collapsed"/></Border>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="SyncOnlyModsButton" Content="Check" MinWidth="120" Height="36" Style="{StaticResource CompactSecondaryButtonStyle}" Click="ReviewMods_Click"/>
        <Button Content="More actions" Style="{StaticResource GhostButtonStyle}" Margin="0,4,0,0" Click="OpenActions_Click" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}" AutomationProperties.Name="More mods actions">
          <Button.ContextMenu><ContextMenu Style="{StaticResource {x:Type ContextMenu}}"><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="PushOnlyModsButton" Header="Push mods…" Click="PushOnlyMods_Click" /><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="OpenModsMenuItem" Header="Open folder" Click="OpenModsFolder_Click" /><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="ViewModsMenuItem" Header="View repository" Click="OpenWebRepo_Click" /><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="ReinstallModsButton" Header="Reinstall mods…" Click="ReinstallMods_Click" /></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid></Border><Border Style="{StaticResource ContentCardStyle}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Resource Packs" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="ResourceStateText" Text="Not checked" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="PackStatusText" Text="Counts available after checking" Style="{StaticResource MetadataTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ResourceRepoText" Style="{StaticResource MetadataTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="SyncResourcesButton" Content="Check" MinWidth="120" Height="36" Style="{StaticResource CompactSecondaryButtonStyle}" Click="ReviewResources_Click"/>
        <Button Content="More actions" Style="{StaticResource GhostButtonStyle}" Margin="0,4,0,0" Click="OpenActions_Click" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}" AutomationProperties.Name="More resource packs actions">
          <Button.ContextMenu><ContextMenu Style="{StaticResource {x:Type ContextMenu}}"><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="PushResourcesButton" Header="Push resource packs…" Click="PushResources_Click" /><Separator/><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="SyncOrderButton" Header="Apply repository order…" Click="SyncOrder_Click" /><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="PushOrderButton" Header="Publish local order…" Click="PushOrder_Click" /><Separator/><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="ReinstallResourcesButton" Header="Reinstall resource packs…" Click="ReinstallResources_Click" /></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid></Border><Border Style="{StaticResource ContentCardStyle}"><Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,16,0">
        <TextBlock Text="Shaders" FontSize="15" FontWeight="SemiBold"/>
        <TextBlock x:Name="ShaderStateText" Text="Not checked" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ShaderStatusText" Text="Counts available after checking" Style="{StaticResource MetadataTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <TextBlock x:Name="ShaderRepoText" Style="{StaticResource MetadataTextStyle}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>

      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <Button x:Name="SyncShadersButton" Content="Check" MinWidth="120" Height="36" Style="{StaticResource CompactSecondaryButtonStyle}" Click="ReviewShaders_Click"/>
        <Button Content="More actions" Style="{StaticResource GhostButtonStyle}" Margin="0,4,0,0" Click="OpenActions_Click" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}" AutomationProperties.Name="More shaders actions">
          <Button.ContextMenu><ContextMenu Style="{StaticResource {x:Type ContextMenu}}"><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="PushShadersButton" Header="Push shaders…" Click="PushShaders_Click" /><MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="ReinstallShadersButton" Header="Reinstall shaders…" Click="ReinstallShaders_Click" /></ContextMenu></Button.ContextMenu>
        </Button>
      </StackPanel>
    </Grid></Border>                    <Border x:Name="FabricCard"
                            Visibility="Visible"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="18,12"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Status Indicator Dot -->
                            <Ellipse x:Name="FabricStatusDot"
                                     Grid.Column="0"
                                     Width="9"
                                     Height="9"
                                     Fill="{DynamicResource WarningBrush}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />

                            <!-- Fabric Details & Version Comparison -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Fabric Loader"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock x:Name="FabricGameVersionText"
                                               Text=" • Minecraft"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Version Comparison: Installed vs Required -->
                                <StackPanel x:Name="FabricVersionComparison" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,0">
                                    <TextBlock Text="Installed: "
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="FabricInstalledVersionText"
                                               Text="Not Installed"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                    <TextBlock Text="   →   Required: "
                                               FontSize="11.5"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <TextBlock x:Name="FabricTargetVersionText"
                                               Text="0.16.9"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Up to Date Badge or Action Button -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <Border x:Name="FabricUpToDateBadge"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource SecondaryButtonBrush}"
                                        CornerRadius="8"
                                        Padding="10,4"
                                        HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="✓"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource SuccessBrush}"
                                                   Margin="0,0,5,0" />
                                        <TextBlock Text="Up to date"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="FabricUpdateButton"
                                        Content="Update Fabric"
                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                        MinWidth="76"
                                        Height="32"
                                        Padding="12,0"
                                        Click="FabricUpdateButton_Click"
                                        ToolTip="Install or update Fabric Loader to the required version" />
                            </StackPanel>
                        </Grid>
                    </Border>
<WrapPanel Margin="0,0,0,12">
  <Button x:Name="SyncModsButton" Content="Review all changes" Style="{StaticResource CompactPrimaryButtonStyle}" Click="SyncMods_Click" Padding="16,8" Margin="0,0,8,0"/>
  <Button Content="Modpack actions" Style="{StaticResource GhostButtonStyle}" Click="OpenActions_Click" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}"><Button.ContextMenu><ContextMenu Style="{StaticResource {x:Type ContextMenu}}">
    <MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="PushModsButton" Header="Push modpack…" Click="PushMods_Click"/>
    <MenuItem Style="{StaticResource {x:Type MenuItem}}" x:Name="FrontCheckUpdatesButton" Header="Check for app updates" Click="CheckForUpdates_Click"/>
  </ContextMenu></Button.ContextMenu></Button>
</WrapPanel>
</StackPanel></ScrollViewer>
<Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" Margin="0,12,0,0">
 <UniformGrid Columns="3" IsEnabled="{Binding IsEnabled, ElementName=DashboardCheckButton}">
 <Button x:Name="ChooseInstanceButton" Content="Instances" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" Click="ChooseInstance_Click"/>
 <Button Content="Repositories" Style="{StaticResource GhostButtonStyle}" Click="SwitchRepo_Click"/>
 <Button Content="Backups" Style="{StaticResource GhostButtonStyle}" Click="OpenBackups_Click"/>
 <Button Content="Settings" Style="{StaticResource GhostButtonStyle}" Click="Settings_Click"/>
 </UniformGrid>
</Border>
<StackPanel Grid.Row="3" Margin="0,8,0,0">
                    <Border x:Name="ProgressArea"
                            Visibility="Collapsed"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="14,11"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <!-- Top Row: Status Title (Left) + Percentage Badge (Right) -->
                            <Grid Margin="0,0,0,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ProgressStatusText"
                                           Text="Syncing mods..."
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />

                                <TextBlock x:Name="ProgressPercentageText"
                                           Grid.Column="1"
                                           Text="100%"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="Collapsed" />
                            </Grid>

                            <!-- Progress Bar (Track & Fill) -->
                            <Border CornerRadius="3"
                                    ClipToBounds="True"
                                    Background="{DynamicResource SecondaryButtonBrush}"
                                    Height="6"
                                    Margin="0,0,0,7">
                                <ProgressBar x:Name="TaskProgressBar"
                                             IsIndeterminate="True"
                                             Height="6"
                                             Foreground="{DynamicResource AccentTextBrush}"
                                             Background="Transparent"
                                             BorderThickness="0" />
                            </Border>

                            <!-- Bottom Row: Item Details (Left) + Speed / ETA (Right) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="ProgressDetailsText"
                                           Text="Preparing sync..."
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           MaxWidth="210"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed" />

                                <TextBlock x:Name="ProgressSpeedEtaText"
                                           Grid.Column="1"
                                           Text="ETA --"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           Visibility="Collapsed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Button x:Name="PauseUpdateButton" Content="Pause Download" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" Click="PauseUpdate_Click" Margin="0,0,0,8" />
</StackPanel>
                <!-- Feedback / Toast Card (Bottom notification area) -->
                <Border x:Name="FeedbackCard"
                        Grid.Row="4"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,12,0,0"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FeedbackMessageText" TextWrapping="Wrap"
                                   Text="Mods are up to date."
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RecoveryButton" Grid.Column="1" Content="Retry" Visibility="Collapsed" Style="{StaticResource GhostButtonStyle}" FontSize="11" Padding="8,2" Click="Recovery_Click" />
                        <Button x:Name="FeedbackActionButton"
                                Grid.Column="1"
                                Content="Open Backup"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="8,2"
                                FontSize="11"
                                Margin="8,0,4,0"
                                Visibility="Collapsed"
                                Click="FeedbackAction_Click" />
                        <Button Grid.Column="2"
                                Content="Dismiss"
                                Style="{StaticResource GhostButtonStyle}"
                                Padding="6,2"
                                FontSize="11"
                                Click="DismissFeedback_Click" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ======================================================== -->
            <!-- MODAL OVERLAYS (Apple Sheet Style)                       -->
            <!-- ======================================================== -->
            <Grid x:Name="ModalBackdrop" KeyboardNavigation.TabNavigation="Cycle"
                  Background="{DynamicResource ModalBackdropBrush}"
                  Visibility="Collapsed">

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalAlignment="Center" MaxHeight="{Binding ActualHeight, ElementName=ModalBackdrop}">
                <!-- Centered Sheet Card -->
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18"
                        Padding="28,24"
                        Width="510"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">

                    <Grid>
                <StackPanel x:Name="ChoiceSheet" Visibility="Collapsed">
                  <TextBlock Text="{Binding Text, ElementName=InstanceNameText}" TextTrimming="CharacterEllipsis" Style="{StaticResource MetadataTextStyle}" Margin="0,0,0,8"/>
                  <TextBlock x:Name="ChoiceTitle" TextWrapping="Wrap" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                  <TextBlock x:Name="ChoiceBody" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,16"/>
                  <Button x:Name="ChoiceFirst" Click="Choice_Click" Style="{StaticResource PrimaryButtonStyle}" MinHeight="40" Margin="0,0,0,8"/>
                  <Button x:Name="ChoiceSecond" Click="Choice_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40" Margin="0,0,0,8"/>
                  <Button x:Name="ChoiceThird" Click="Choice_Click" Style="{StaticResource SecondaryButtonStyle}" MinHeight="40"/>
                </StackPanel>
                <Border x:Name="InstanceSheet" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Choose your Minecraft instance" FontSize="20" FontWeight="SemiBold" />
                        <TextBlock x:Name="InstanceIntroText" Text="Start with the folder beside ModSync, or select an installed instance. Your choice is remembered across updates." TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,14" />
                        <ListBox x:Name="InstanceList" MaxHeight="190" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource CardBorderBrush}" SelectionChanged="InstanceSelectionChanged">
                            <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBackground" Padding="4" Background="Transparent" CornerRadius="6"><ContentPresenter /></Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ItemBackground" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" /><Setter TargetName="ItemBackground" Property="BorderThickness" Value="1" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Setter.Value></Setter>
                            </Style></ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="4"><TextBlock Text="{Binding Name}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontWeight="SemiBold" /><TextBlock Text="{Binding Folder}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" FontSize="11" TextWrapping="Wrap" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="InstanceSelectedPathText" FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" />
                        <TextBlock x:Name="InstanceErrorText" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ErrorBrush}" Margin="0,8,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                            <Button Content="Browse…" Style="{StaticResource GhostButtonStyle}" Click="BrowseInstance_Click" />
                            <Button x:Name="InstanceCancelButton" Content="Cancel" Style="{StaticResource GhostButtonStyle}" Click="CloseModal_Click" />
                            <Button x:Name="ConfirmInstanceButton" Content="Use Instance" Style="{StaticResource PrimaryButtonStyle}" Padding="14,8" Click="ConfirmInstance_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                        <!-- ================= 1. PUSH CONFIRMATION MODAL ================= -->
                        <StackPanel x:Name="PushConfirmSheet" Visibility="Collapsed">
                            <TextBlock x:Name="PushConfirmTitleText" Text="Push Modpack Changes?"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,6" />
                            <TextBlock x:Name="PushConfirmSummaryText"
                                       Text="Changes detected: +2 added, ~1 updated"
                                       FontSize="13"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,12" />

                            <Border Background="{DynamicResource InputBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,18">
                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PushDetailsText"
                                               FontSize="12"
                                               FontFamily="Consolas, monospace"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>

                            <TextBlock Text="These changes will be committed and uploaded to GitHub."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,16" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="90"
                                        Margin="0,0,10,0"
                                        Click="CloseModal_Click" />
                                <Button Content="Push Changes"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="42"
                                        Width="130"
                                        Click="ConfirmPush_Click" />
                            </StackPanel>
                        </StackPanel>

                        <!-- ================= 2. GITHUB LOGIN MODAL ================= -->
                        <StackPanel x:Name="LoginSheet" Visibility="Collapsed">
                            <TextBlock Text="GitHub Login"
                                       FontSize="18"
