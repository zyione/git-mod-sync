                                                        Content="Open Web"
                                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Click="OpenWebRepo_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <Button Content="Done"
