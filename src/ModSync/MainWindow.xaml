                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="Open mod repository page in web browser"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
