                        <!-- ================= 5. SETTINGS / CONFIG MODAL ================= -->
                        <StackPanel x:Name="SettingsSheet" Visibility="Collapsed">
<Button x:Name="AuthButton" Content="GitHub Login" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Right" Click="Auth_Click"/>
                            <TextBlock Text="Settings &amp; Maintenance"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,3" />
                            <TextBlock Text="Preferences, mod exclusions, and maintenance tools."
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,0,0,12" />

                            <ScrollViewer MaxHeight="390" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">
                                    <!-- Group 1: Preferences -->
                                    <TextBlock Text="PREFERENCES"
