                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="Open debug logs in Windows File Explorer"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button Grid.Column="1"
                                                        Content="Open Logs"
                                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Click="OpenLogs_Click" />
                                            </Grid>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8" />

