                                                    <TextBlock x:Name="SettingsAppVersionText"
                                                               Text="ModSync v1.0.0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <Button x:Name="CheckAppUpdatesButton"
                                                        Grid.Column="1"
                                                        Content="Check Updates"
                                                        Style="{StaticResource CompactSecondaryButtonStyle}"
                                                        VerticalAlignment="Center"
                                                        HorizontalAlignment="Right"
                                                        Click="CheckForUpdates_Click" />
                                            </Grid>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8" />

                                            <!-- Clean Reinstall Mods Row -->
                                            <Grid Margin="0,5">
