                                    CornerRadius="10"
                                    Padding="14,12"
                                    Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="What happens during a Clean Reinstall:"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                               Margin="0,0,0,8" />

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock x:Name="ReinstallStepOneText" TextWrapping="Wrap" Text="1. Backs up mods, enabled packs, and pack settings:"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock x:Name="CleanReinstallBackupPreviewText"
                                                   Text="modsync_backups/reinstall_.../"
                                                   FontFamily="Consolas, monospace"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   Margin="14,2,0,0" />
