                                            </Grid>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8" />

                                            <!-- Auto-Check Updates -->
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                                    <TextBlock Text="Check for App Updates"
                                                               FontSize="13"
                                                               FontWeight="Medium"
                                                               Foreground="{DynamicResource PrimaryTextBrush}" />
                                                    <TextBlock Text="Automatically check for new ModSync.exe versions on launch"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <CheckBox x:Name="AutoCheckUpdatesToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppleToggleSwitchStyle}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"
                                                          Margin="0,0,2,0"
                                                          Click="SettingToggle_Click" />
                                            </Grid>

                                            <!-- Divider -->
                                            <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,8" />

                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
