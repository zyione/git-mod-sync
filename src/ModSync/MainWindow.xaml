                                <TextBlock Text="Branch" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <TextBox x:Name="ShaderBranchInput" Style="{StaticResource MinimalTextBoxStyle}" FontSize="12" Width="130" Height="32" Padding="10,4" AutomationProperties.Name="Shaders branch" />
                            </StackPanel>
                            <Button Content="Use Default Repositories" Style="{StaticResource GhostButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,12" Click="ResetDefaultRepo_Click" />
