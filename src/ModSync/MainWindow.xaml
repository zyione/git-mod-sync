                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               Margin="0,2,0,0" />
                                                </StackPanel>
                                                <CheckBox x:Name="ConfirmPushToggle"
                                                          Grid.Column="1"
                                                          Style="{StaticResource AppleToggleSwitchStyle}"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="Right"
                                                          Margin="0,0,2,0"
