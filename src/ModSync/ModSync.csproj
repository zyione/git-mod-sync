<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ModSync</RootNamespace>
    <AssemblyName>ModSync</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/modsync-dark.ico</ApplicationIcon>
    
    <!-- Application Metadata -->
    <Version>1.6.1</Version>
    <AssemblyVersion>1.6.1.0</AssemblyVersion>
    <FileVersion>1.6.1.0</FileVersion>
    <Product>ModSync</Product>
    <Title>ModSync - Minecraft Mod Manager</Title>
    <Company>ModSync</Company>
    <Description>Fast, safe, zero-configuration Minecraft mods folder synchronization with GitHub.</Description>

    <!-- Publishing defaults for Windows Self-Contained Single-File Executable -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/modsync-dark.ico" />
    <Resource Include="Assets/modsync-light.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="System.IO.Path" Alias="Path" />
    <Using Include="System.IO.File" Alias="File" />
    <Using Include="System.IO.Directory" Alias="Directory" />
  </ItemGroup>

</Project>












