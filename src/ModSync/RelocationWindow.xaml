<Window x:Class="ModSync.RelocationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Move ModSync" Width="560" Height="540" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}" Icon="{DynamicResource AppIcon}" FontFamily="{StaticResource SystemFont}" FontSize="13">
    <Border Padding="24" Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="Move ModSync out of your instance" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,12,0,16" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="This copy is inside a BigChadGuys instance. Confirm the launcher folder below so ModSync can live beside your instances."/>
                <Border Style="{StaticResource ContentCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Move to" FontWeight="SemiBold"/>
                        <TextBlock x:Name="DestinationText" Margin="0,8,0,12" TextWrapping="Wrap"/>
                        <Button Content="Choose UltimMC folder…" HorizontalAlignment="Left" Style="{StaticResource CompactSecondaryButtonStyle}" Click="Browse_Click"/>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ExplanationText" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"/>
                <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}"
                           Text="After reopening, confirm your instance and exclusions. Update old shortcuts and review Launch check setup with UltimMC closed. Game files and existing launch commands stay in place."/>
                <TextBlock x:Name="ErrorText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,12,0" Style="{StaticResource CompactSecondaryButtonStyle}"/>
            <Button x:Name="ConfirmButton" Content="Confirm &amp; move" Style="{StaticResource CompactPrimaryButtonStyle}" Click="Confirm_Click"/>
        </StackPanel>
    </Grid>
    </Border>
</Window>
